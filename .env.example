# Copy this to a file named .env (never commit .env to GitHub).
# In GitHub Actions, put these same values under repo Settings > Secrets.

# Free key from Google AI Studio (https://aistudio.google.com)
GEMINI_API_KEY=

# From developers.facebook.com > your app > WhatsApp > API Setup
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Your own WhatsApp number, digits only, country code included, no + or spaces
WHATSAPP_RECIPIENT=
# Name of the message template you created and got approved
WHATSAPP_TEMPLATE=daily_briefing
